NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://errsight:errsight@localhost:5432/errsight

REDIS_HOST=localhost
REDIS_PORT=6379

# REQUIRED in production - the app refuses to start without this set when
# NODE_ENV=production (docker-compose also refuses to start the containers
# without it). Only falls back to an insecure default in development.
JWT_SECRET=change-this-to-a-long-random-string

# Short-lived ACCESS token (also used to sign email-verification links).
# Staying signed in long-term is the refresh token's job now, not this.
JWT_EXPIRES_IN=15m

# How long a refresh token stays valid before the user has to log in again
# from scratch (rotated on every use - see src/routes/auth.ts).
REFRESH_TOKEN_EXPIRES_DAYS=30

# Used to build links in verification/password-reset emails. Point this
# at wherever the dashboard is actually served.
APP_URL=http://localhost:5173

# Comma-separated origins allowed to call the JWT-authed dashboard API
# (e.g. https://app.errsight.dev). Leave blank in development. In
# production, leaving this blank means the dashboard API rejects all
# cross-origin requests - does NOT affect /api/ingest, which intentionally
# accepts any origin (the SDK runs on arbitrary third-party sites).
CORS_ORIGIN=

INGEST_RATE_WINDOW_MS=60000
INGEST_RATE_MAX=100

# Login/register brute-force protection (separate, stricter limit than ingest)
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=10

# Optional - if unset, new-error-group alerts are only logged, never sent
SLACK_WEBHOOK_URL=
